NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/labourchowck
JWT_SECRET=change-me-to-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Plain OTP is printed to the server terminal when NODE_ENV is not production.
# Set to true to also print OTP when NODE_ENV=production (e.g. staging only).
OTP_DEV_LOG=true
SEED_ADMIN_EMAIL=admin@Staffivaa.com
SEED_ADMIN_PASSWORD=admin@123
SEED_ADMIN_PHONE=8999999999

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true

# Global Rate Limit (Default: 300 requests per 15 minutes)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300

# OTP Request Rate Limit (Default: 5 requests per 1 minute)
RATE_LIMIT_OTP_WINDOW_MS=60000
RATE_LIMIT_OTP_MAX=5

# Auth / Login Verification Rate Limit (Default: 10 requests per 15 minutes)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# File Upload Rate Limit (Default: 30 requests per 15 minutes)
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=30

# Booking Rate Limit (Default: 20 requests per 10 minutes)
RATE_LIMIT_BOOKING_WINDOW_MS=600000
RATE_LIMIT_BOOKING_MAX=20

# Payment Rate Limit (Default: 15 requests per 10 minutes)
RATE_LIMIT_PAYMENT_WINDOW_MS=600000
RATE_LIMIT_PAYMENT_MAX=15

# Withdrawal Rate Limit (Default: 10 requests per 10 minutes)
RATE_LIMIT_WITHDRAWAL_WINDOW_MS=600000
RATE_LIMIT_WITHDRAWAL_MAX=10

# Razorpay (required for wallet recharge and booking payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Optional: webhook signature verification
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
